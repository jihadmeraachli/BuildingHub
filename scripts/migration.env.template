# ============================================================
# Frankfurt migration credentials — Option C (Claude-driven)
#
# HOW TO USE
#   1. Copy this file to  scripts/migration.env   (gitignored — verify with
#      `git status`: it must NOT appear).
#   2. Fill what you can. Leave unknowns blank and tell Claude — most can be
#      regenerated fresh (notes per line below).
#   3. After the migration: delete scripts/migration.env, revoke the PAT and
#      the Cloudflare token.
#
# Nothing in this file is ever committed, echoed into chat, or sent anywhere
# except the service it belongs to.
# ============================================================

# ── Driving tokens (create for the migration, revoke after) ──────────────

# Supabase Personal Access Token — supabase.com/dashboard/account/tokens
# → "Generate new token", name it "frankfurt-migration".
# Unlocks: create the new project, deploy all 12 edge functions via CLI,
# set function secrets, configure Auth/SMTP via the Management API.
# ⚠️ Account-wide token: hand it over only for the migration window.
SUPABASE_ACCESS_TOKEN=

# Cloudflare API token — dash.cloudflare.com → My Profile → API Tokens →
# Create Token → permission: Account / Cloudflare Pages / Edit.
# Unlocks: the final env-var flip + redeploy. (Optional — it's 2 fields you
# can also click by hand at cutover; leave blank to do it yourself.)
CLOUDFLARE_API_TOKEN=

# ── Old (Seoul) project ──────────────────────────────────────────────────

# The database password you set when configuring the backup workflow
# (BACKUPS.md, 2026-07-31 — likely in your password manager).
# If lost: old project → Database Settings → reset password (safe at 0
# users; the GitHub backup secret gets replaced at cutover anyway).
OLD_DB_PASSWORD=

# Old project service_role key — Dashboard → Settings → API → service_role.
# Unlocks: reading the storage buckets to copy files out.
OLD_SERVICE_ROLE_KEY=

# ── Edge-function secret VALUES (Supabase can't read these back out of the
#    old project — they come from your own sources) ──────────────────────

# resend.com → API Keys. If lost: create a NEW sending-scope key (2 min) —
# it also becomes the Auth SMTP password on the new project.
RESEND_API_KEY=

# console.anthropic.com → API Keys. If lost: create a new key (2 min).
ANTHROPIC_API_KEY=

# Meta Business → System User → permanent token (whatsapp_business_messaging).
# If lost: generate a new token for the same System User (5 min) — the
# phone number and templates are untouched.
WHATSAPP_TOKEN=

# Not secret — visible in developers.facebook.com → WhatsApp → API Setup.
WHATSAPP_PHONE_ID=

# ⚠️ THE ONE THAT MATTERS: the full contents of the APNs .p8 file,
# including the BEGIN/END PRIVATE KEY lines. Apple lets you download a .p8
# exactly once. If the file is lost: Apple Developer portal → Keys → revoke
# the old key → create a new APNs key → download the new .p8 → put its NEW
# Key ID below (Team ID stays 8PHJEU7CDL).
# Multi-line value: keep it exactly as in the file, wrapped in quotes.
APNS_PRIVATE_KEY=
APNS_KEY_ID=222WU36W5N
APNS_TEAM_ID=8PHJEU7CDL

# ── New (Frankfurt) project — FILLED BY CLAUDE on migration night ─────────
# Created via the Management API with your PAT; you never need to touch these.
NEW_REF=
NEW_DB_PASSWORD=
NEW_ANON_KEY=
NEW_SERVICE_ROLE_KEY=

# ── Fresh — Claude generates these, nothing to find ──────────────────────
# CRON_SECRET and WEBHOOK_SECRET are only compared against values we set
# ourselves (cron job / webhook headers), so brand-new random values are
# used on Frankfurt. Nothing needed from you.

# ── Skipped ──────────────────────────────────────────────────────────────
# WHISH_* / AREEBA_* were never set on Seoul (awaiting approvals) — nothing
# to migrate. FROM_EMAIL / APP_URL are not secrets (notifications@abniyah.com,
# https://app.abniyah.com) and are set automatically.
